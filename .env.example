# -------------------------------------------------------
# Copy this file to .env for local development.
# On Render, set these in the Environment Variables panel.
# NEVER commit real credentials or .env to version control.
# -------------------------------------------------------

# Groq Cloud API key — https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# GitHub App webhook secret (must match what you set in GitHub App settings)
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here

# GitHub App credentials
GITHUB_APP_ID=your_github_app_id_here
GITHUB_INSTALLATION_ID=your_installation_id_here

# Base64-encoded PEM private key
GITHUB_APP_PRIVATE_KEY=your_base64_private_key_here